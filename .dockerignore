# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# 测试缓存
.pytest_cache/
.pytest_tmp/

# 虚拟环境
venv/
.venv/

# 环境变量（敏感信息，通过 -e 或 docker-compose 传入）
.env

# 本地配置含 API Key 等敏感信息，绝不打包进镜像，运行时只读挂载
config/config.json
config*.bak

# 输出目录（运行时通过 volume 挂载，不打包进镜像）
output/

# 自动词表：只在宿主机用 tools/sync_glossary.py 生成后只读挂载，
# 不打包进镜像，避免镜像里带一份陈旧词表
glossary/glossary.auto.json
glossary/glossary.auto.index.json

# 验证码临时文件
captcha*.png

# 调试与测试文件
debug*.*
test*.*

# 文档
*.md
docs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 历史归档与本地原始数据
archive/
data/

# CI/CD
.github/

# 本文件自身
.dockerignore
