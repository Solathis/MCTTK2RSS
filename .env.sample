# ── 翻译 API ─────────────────────────────────────────
# config.json 的 openai_compat.api_key_env 指向这个变量
OPENAI_API_KEY=sk-

# ── MCBBS 账号 ───────────────────────────────────────
MCBBS_USERNAME=
MCBBS_PASSWORD=

# ── 日志（可选，留空/删除即用默认值）──────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR；排查问题时改成 DEBUG
MCTTK_LOG_LEVEL=INFO
# 日志保留天数，0 表示永久保留
MCTTK_LOG_KEEP_DAYS=90

# ── 定时调度（Docker 默认入口 scheduler.py，可选）─────
# 两轮之间的间隔秒数（默认 3600 = 1 小时）
MCTTK_INTERVAL=3600
# 单轮 main.py 的超时秒数（默认 3600 = 1 小时）
MCTTK_RUN_TIMEOUT=3600
