# 上游同步策略：以下文件是我们 fork 的自定义文件
# merge=ours 在合并冲突时自动优先保留我们的版本
# 上游对这些文件的更改不会覆盖我们的自定义实现
# 配合手动 cherry-pick 或 merge 时可追加 --strategy-option=theirs 指定单次反选

# 核心自定义文件：RSS 生成 + 编排流程 + HTTP 服务
main.py merge=ours
rss_generator.py merge=ours
scheduler.py merge=ours
server.py merge=ours
init_state.py merge=ours
scraper.py merge=ours
log_setup.py merge=ours

# 配置：RSS 配置是自定义的
config.json merge=ours
pyproject.toml merge=ours

# Docker 部署配置
docker-compose.yml merge=ours
Dockerfile merge=ours
Dockerfile.git merge=ours

# .env 模板
.env.sample merge=ours

# GitHub Actions workflow
.github/workflows/rss-publish.yml merge=ours
.github/workflows/docker-build.yml merge=ours
.github/workflows/clear-articles.yml merge=ours

# 上游同步文档
UPSTREAM_SYNC.md merge=ours

