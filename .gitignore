# 输出文件（不提交到仓库）
output/*.txt
output/*.md
output/*.jpg
output/*.jpeg
output/*.png
output/*.gif
output/*.webp
output/*.json

# 注意：.posted.json *会* 被 git 跟踪
# 注意：.state.json 不会 被 git 跟踪
# 注意：feed.xml 由 GitHub Actions 部署到 gh-pages 分支，不在主分支跟踪

# 日志文件
logs/

# 旧版文件
old/

# RSS feed 输出（由 CI 部署到 gh-pages，不提交主分支）
output/feed.xml

# 验证码临时文件
captcha.png
captcha*.png

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 环境
.env
venv/
.venv/

# 根目录下的调试文件不提交
debug*.*
test*.*
glossary_*.json

# 测试文件夹下的调试文件*需要*提交
!tests/test_*.*
