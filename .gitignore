# 输出文件（不提交到仓库）
output/*.txt
output/*.md
output/*.jpg
output/*.jpeg
output/*.png
output/*.gif
output/*.webp
output/*.json
# 专栏 HTML 产物与 tools/preview_bili_html.py 生成的预览页
output/*.html

# 运行期状态文件一律不入库：它们属于具体部署的 output 卷，入库只会让工作区永远 dirty，
# 而且仓库里那份必然是过期快照（曾经靠一个自动提交的 workflow 同步，那个 workflow 已停用）。
# 想跨机器保留发布记录，请备份 output 卷或单独导出这几份 json，不要塞回 git。
output/.posted.json
output/.state.json
output/.posted_bili.json
output/.mcbbs_threads.json

# 配置文件：本地配置不入库（模板见 config/config.sample.json），备份文件同样不入库
# config/modules_config.json 与 config/config.sample.json 仍然入库
config/config.json
config*.bak
# B站登录 cookie（SESSDATA 等价于账号密码），绝不入库
config/bili_cookies.json

# 日志文件
logs/

# 历史归档：上一代项目、实验脚本、本地备份，只留在本地
/archive/

# 本地原始数据：官方术语表 TSV、语言文件快照等，体积大且可重新下载
/data/

# 验证码临时文件
captcha.png
captcha*.png

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 测试缓存
.pytest_cache/
.pytest_tmp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 环境
.env
venv/
.venv/

# 本地 Agent 协作规范：AGENTS.md / CLAUDE.md 才入库，
# .local 后缀是个人本地 overlay，只留本机
AGENTS.local.md
CLAUDE.local.md

# 根目录下的调试文件不提交
debug*.*
test*.*

# 自动生成的词汇表层与溯源索引（tools/sync_glossary.py 产出），
# 手写的 glossary/glossary.json 仍然入库
glossary/glossary.auto.json
glossary/glossary.auto.index.json
glossary_*.json

# 测试文件夹下的调试文件*需要*提交
!tests/test_*.*
